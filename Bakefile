#!/bin/bash

use php

PORT=4001
ENTRYPOINT="server/index.php"

export ISSUER=http://nym.localhost:$PORT
export HMAC_SIGNING_KEY=69420wowpenis

serve() {
  php -S 0.0.0.0:$PORT $ENTRYPOINT
}

deploy() {
  lift deploy nym
}

publish() {
  (cd client/elixir && mix docs)
  lift deploy docs
}

release() {
  (cd client/elixir && mix hex.publish)
}

generate-secret() {
  php -r '
  $secret = bin2hex(random_bytes(32));
  echo "Secret: $secret\n";
  echo "Hash: " . password_hash($secret, PASSWORD_DEFAULT) . "\n";
  '
}

generate-keypair() {
  php -r 'echo "HMAC_SIGNING_KEY=" . bin2hex(random_bytes(32)) . "\n";'
  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$PWD/server/private.pem"
  chmod 600 "$PWD/server/private.pem"
  echo "RSA_SIGNING_KEY=$PWD/server/private.pem"
}

generate-sub() {
  php -r 'echo rtrim(strtr(base64_encode(random_bytes(16)), "+/", "-_"), "=") . "\n";'
}

generate-passphrase() {
  export PASSPHRASE=$1

  php -r '
  $passphrase = getenv("PASSPHRASE");
  echo password_hash($passphrase, PASSWORD_DEFAULT) . "\n";
  '
}

generate-totp() {
  export TOTP_USER=$1

  php -r '
  require "server/neuro/std.php";

  $secret = base32_encode(random_bytes(20));
  $uri = "otpauth://totp/Nym:" . rawurlencode(getenv("TOTP_USER")) . "?secret=$secret&issuer=Nym";

  echo "Secret: $secret\n";
  echo "URI: $uri\n";

  if(shell_exec("command -v qrencode")) passthru("qrencode -t ansiutf8 " . escapeshellarg($uri));
  '
}
